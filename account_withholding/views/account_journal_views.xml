<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- make default_account_id optional if withholdings journal -->
            <field name="default_account_id" position="attributes">
                <attributes name="invisible">
                    account_type == False
                </attributes>
                <attributes name="required">
                    (id != False and account_type in ['bank', 'cash'] and 'withholding' not in selected_payment_method_codes) or account_type in ['bank', 'cash']
                </attributes>
            </field>
        </field>
    </record>
</odoo>
